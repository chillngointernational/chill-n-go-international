# Plantilla de variables de entorno. Copiá a .env.local y completá con los valores reales.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Key de Mercado Pago (app de MEMBRESÍA). Producción = APP_USR-... Es publicable (va en el
# bundle del navegador): el Card Payment Brick la usa para tokenizar la tarjeta. NUNCA el access token.
VITE_MP_PUBLIC_KEY=
